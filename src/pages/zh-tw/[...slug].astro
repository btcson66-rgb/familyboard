---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolWorkbench from '../../components/ToolWorkbench';
import Recommendation from '../../components/Recommendation.astro';
import { createRedirectStub } from '../../lib/redirect-stub';
import { clusterSiblings } from '../../lib/cluster-links';
import { isRouteIndexable } from '../../lib/indexability';

export async function getStaticPaths() {
  const pages = await getCollection('pagesZhTw');
  return pages.filter((entry) => entry.data.route !== '/zh-tw/').map((entry) => ({
    params: { slug: entry.data.route.replace(/^\/zh-tw\/+|\/+$/g, '') },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const redirectStub = entry.data.redirectTo ? createRedirectStub(entry.data.redirectTo) : null;
const pages = await getCollection('pagesZhTw');
const pageIndexable = isRouteIndexable(entry.data.route);
const alternatePath = pageIndexable && entry.data.alternateRoute && isRouteIndexable(entry.data.alternateRoute)
  ? entry.data.alternateRoute
  : undefined;
const related = entry.data.related
  .map((route: string) => pages.find((candidate) => candidate.data.route === route))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const routeSlug = entry.data.route.split('/').filter(Boolean).at(-1) || '';
// Collection hubs. The English tree has listed its children since launch; the
// Traditional Chinese tree never did, which left all 515 zh-TW pages with no
// top-down discovery path — only the sitemap, their curated `related` links and
// the cluster ring below. That is the locale that ranks best in the Search
// Console data, so it is the last place that should be hard for Google to walk.
const isHub = ['/zh-tw/guides/', '/zh-tw/tools/', '/zh-tw/checklists/', '/zh-tw/templates/', '/zh-tw/features/'].includes(entry.data.route);
const hubItems = isHub ? pages.filter((candidate) => {
  if (candidate.data.redirectTo || !isRouteIndexable(candidate.data.route)) return false;
  if (candidate.data.route === entry.data.route) return false;
  return candidate.data.route.startsWith(entry.data.route);
}).sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-Hant')) : [];
const clusterLabels: Record<string, string> = {
  maintenance: '居家保養',
  appliances: '家電',
  'inventory-warranty': '財物與保固',
  'records-emergency': '紀錄與緊急應變',
  'household-operations': '家庭運作',
  tools: '工具',
  product: '產品',
  printables: '可列印',
  support: '服務資訊',
};
const guideGroupOrder = ['maintenance', 'appliances', 'inventory-warranty', 'records-emergency', 'household-operations', 'tools', 'product', 'support'];
const guideGroups = entry.data.route === '/zh-tw/guides/' ? guideGroupOrder.map((cluster) => ({
  cluster,
  items: hubItems.filter((item) => item.data.cluster === cluster),
})).filter((group) => group.items.length > 0) : [];
// Same cluster ring as the English tree, over the Traditional Chinese collection.
const siblings = isHub || redirectStub ? [] : clusterSiblings(
  { route: entry.data.route, cluster: entry.data.cluster, indexable: pageIndexable, redirectTo: entry.data.redirectTo },
  pages.map((candidate) => ({
    route: candidate.data.route,
    cluster: candidate.data.cluster,
    indexable: isRouteIndexable(candidate.data.route),
    redirectTo: candidate.data.redirectTo,
    title: candidate.data.title,
    description: candidate.data.description,
  })),
  { count: 6, exclude: entry.data.related },
);
const pageType = entry.data.pageType === 'content' ? 'article' : 'website';
const pageTypeLabel = entry.data.pageType === 'tool' ? '免費工具' : entry.data.pageType === 'support' ? '服務資訊' : '實用指南';
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={redirectStub?.canonicalPath ?? entry.data.route}
  alternatePath={redirectStub ? undefined : alternatePath}
  languageSwitchPath={redirectStub ? undefined : entry.data.alternateRoute}
  locale="zh-TW"
  indexable={redirectStub?.indexable ?? pageIndexable}
  robots={redirectStub?.robots}
  pageType={redirectStub ? 'website' : pageType}
  publishedAt={entry.data.publishedAt}
  lastReviewedAt={entry.data.lastReviewedAt}
  faq={redirectStub ? [] : entry.data.faq}
  publicIntegrationsEnabled={redirectStub?.publicIntegrationsEnabled ?? true}
  redirectRefresh={redirectStub?.refreshContent}
>
  {redirectStub ? <div class="shell page-grid">
    <article class="article redirect-stub">
      <h1>{redirectStub.heading}</h1>
      <p>這個頁面已移至新的 FamilyBoard 教學位置。</p>
      <p><a class="button" href={redirectStub.linkHref}>前往目前頁面</a></p>
    </article>
  </div> : <>
  <Breadcrumbs route={entry.data.route} title={entry.data.title} locale="zh-TW" />
  <div class="shell page-grid">
    <article class="article">
      <div class="meta"><span><a href="/editorial-policy/">FamilyBoard 編輯團隊</a></span><span>發布與複查日期：{entry.data.lastReviewedAt.toLocaleDateString('zh-TW', { dateStyle: 'long' })}</span><span>{pageTypeLabel}</span></div>
      {entry.data.pageType === 'tool' ? <>
        <h1>{entry.data.title.replace(/｜.*$/, '')}</h1>
        <p class="lede"><strong>快速答案：</strong>{entry.data.description}</p>
        <ToolWorkbench client:load slug={routeSlug} title={entry.data.title} locale="zh-TW" />
        <Content />
      </> : <Content />}
      {isHub && <section class="section" aria-labelledby="zh-hub"><div class="section-head"><div><span class="eyebrow">依家庭工作分類</span><h2 id="zh-hub">瀏覽這個分類</h2></div></div>{guideGroups.length > 0 ? guideGroups.map((group) => <section class="hub-group"><h3>{clusterLabels[group.cluster] ?? group.cluster}</h3><div class="card-grid">{group.items.map((item) => <a class="card" href={item.data.route}><span class="card-tag">{clusterLabels[item.data.cluster] ?? item.data.cluster}</span><h3>{item.data.title.replace(/｜.*$/, '')}</h3><p>{item.data.description}</p></a>)}</div></section>) : <div class="card-grid">{hubItems.map((item) => <a class="card" href={item.data.route}><span class="card-tag">{clusterLabels[item.data.cluster] ?? item.data.cluster}</span><h3>{item.data.title.replace(/｜.*$/, '')}</h3><p>{item.data.description}</p></a>)}</div>}</section>}
      <Recommendation route={entry.data.route} locale="zh-TW" />
      {related.length > 0 && <section class="section"><div class="section-head"><h2>繼續使用 FamilyBoard</h2></div><div class="card-grid">{related.map((item) => <a class="card" href={item.data.route}><h3>{item.data.title.replace(/｜.*$/, '')}</h3><p>{item.data.description}</p></a>)}</div></section>}
      {siblings.length > 0 && <section class="section" aria-labelledby="more-in-cluster"><div class="section-head"><div><span class="eyebrow">同一類家庭工作</span><h2 id="more-in-cluster">相關主題</h2></div></div><div class="card-grid">{siblings.map((item) => <a class="card" href={item.route}><h3>{item.title.replace(/｜.*$/, '')}</h3><p>{item.description}</p></a>)}</div></section>}
      <p class="notice">發現錯誤或過期資訊？<a href="/zh-tw/contact/">請提供頁面網址與可靠來源。</a></p>
    </article>
    <aside class="toc-card"><strong>FamilyBoard</strong><p>免費、免帳號的家庭保養、保固與責任管理工具。</p><a class="button" href="/zh-tw/app/">開啟繁中 App</a><p class="help">核心家庭紀錄保留在目前瀏覽器；請定期自行匯出備份。</p>{entry.data.pageType === 'tool' && <p><a href="/zh-tw/">查看繁中首頁</a></p>}</aside>
  </div>
  </>}
</BaseLayout>
