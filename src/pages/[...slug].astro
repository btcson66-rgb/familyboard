---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolWorkbench from '../components/ToolWorkbench';
import PrintableSheet from '../components/PrintableSheet';
import SiteSearch from '../components/SiteSearch';
import Recommendation from '../components/Recommendation.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.filter((entry) => entry.data.route !== '/').map((entry) => ({
    params: { slug: entry.data.route.replace(/^\/+|\/+$/g, '') },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const pages = await getCollection('pages');
const related = entry.data.related.map((route: string) => pages.find((candidate) => candidate.data.route === route)).filter((item): item is NonNullable<typeof item> => Boolean(item));
const routeSlug = entry.data.route.split('/').filter(Boolean).at(-1) || '';
const isHub = ['/guides/', '/tools/', '/checklists/', '/templates/'].includes(entry.data.route);
const hubItems = isHub ? pages.filter((candidate) => {
  if (entry.data.route === '/guides/') return candidate.data.pageType === 'content' && !candidate.data.route.startsWith('/features/');
  return candidate.data.route.startsWith(entry.data.route) && candidate.data.route !== entry.data.route;
}).sort((a, b) => a.data.title.localeCompare(b.data.title)) : [];
const pageType = entry.data.pageType === 'content' ? 'article' : 'website';
---
<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath={entry.data.route} indexable={entry.data.indexable} pageType={pageType} publishedAt={entry.data.publishedAt} lastReviewedAt={entry.data.lastReviewedAt}>
  <Breadcrumbs route={entry.data.route} title={entry.data.title} />
  <div class="shell page-grid">
    <article class="article">
      <div class="meta"><span><a href="/editorial-policy/">FamilyBoard Editorial Team</a></span><span>Published and reviewed {entry.data.lastReviewedAt.toLocaleDateString('en-US', { dateStyle: 'long' })}</span><span>{entry.data.cluster.replace('-', ' ')}</span></div>
      <Content />
      {entry.data.pageType === 'tool' && <ToolWorkbench client:only="react" slug={routeSlug} title={entry.data.title} />}
      {entry.data.pageType === 'printable' && <PrintableSheet client:visible route={entry.data.route} title={entry.data.title} />}
      {entry.data.route === '/search/' && <SiteSearch client:load />}
      {isHub && <section class="section"><div class="section-head"><h2>Explore this collection</h2></div><div class="card-grid">{hubItems.map((item) => <a class="card" href={item.data.route}><span class="card-tag">{item.data.cluster.replace('-', ' ')}</span><h3>{item.data.title.replace(/ \|.*$/, '')}</h3><p>{item.data.description}</p></a>)}</div></section>}
      <Recommendation route={entry.data.route} />
      {related.length > 0 && <section class="section"><div class="section-head"><h2>Keep going</h2></div><div class="card-grid">{related.map((item) => <a class="card" href={item.data.route}><h3>{item.data.title.replace(/ \|.*$/, '')}</h3><p>{item.data.description}</p></a>)}</div></section>}
      <p class="notice">Found an error or an outdated instruction? <a href="/contact/">Send us the page URL and a reliable supporting source.</a></p>
    </article>
    <aside class="toc-card"><strong>FamilyBoard</strong><p>A free local-first system for household maintenance, records and responsibilities.</p><a class="button" href="/app/">Open the app</a><p class="help">No account. Your core household records stay in this browser.</p>{entry.data.pageType === 'tool' && <p><a href="/tools/">Browse all free tools</a></p>}{entry.data.pageType === 'printable' && <p><a href="/templates/">Browse printables</a></p>}</aside>
  </div>
</BaseLayout>
