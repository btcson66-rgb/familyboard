---
import { brand } from '../config/brand';
interface Props { locale?: 'en' | 'zh-TW'; }
const { locale = 'en' } = Astro.props;
const isZhTw = locale === 'zh-TW';

// Deliberately small. This footer used to carry 265 English / 433 Traditional
// Chinese deep links on every page, which made the sitewide boilerplate 67% of
// the average page's HTML and spread internal link equity across ~370 links per
// page. Crawl paths to individual pages are the job of the collection hubs
// (/guides/, /tools/, /checklists/, /templates/, /features/) and of the
// contextual "related" links inside each article — scripts/indexing-audit.mjs
// measures exactly those and strips <footer> before counting, so nothing here
// is load-bearing for discovery. Keep this list to site-level destinations:
// collections, product surfaces, company and legal. Do not reintroduce
// per-article links.
const groups: Array<{ heading: string; links: Array<[string, string]> }> = isZhTw
  ? [
      {
        heading: '內容分類',
        links: [
          ['/zh-tw/guides/', '指南'],
          ['/zh-tw/tools/', '工具'],
          ['/zh-tw/checklists/', '檢查表'],
          ['/zh-tw/templates/', '範本'],
          ['/zh-tw/features/', '功能'],
        ],
      },
      {
        heading: '產品',
        links: [
          ['/zh-tw/app/', '開啟應用程式'],
          ['/zh-tw/pricing/', '價格（免費）'],
          ['/zh-tw/roadmap/', '產品藍圖'],
          ['/zh-tw/changelog/', '更新紀錄'],
        ],
      },
      {
        heading: '關於',
        links: [
          ['/zh-tw/about/', '關於 FamilyBoard'],
          ['/zh-tw/contact/', '聯絡我們'],
          ['/zh-tw/editorial-policy/', '編輯政策'],
        ],
      },
      {
        heading: '法律與隱私',
        links: [
          ['/zh-tw/privacy/', '隱私權政策'],
          ['/zh-tw/security/', '資安說明'],
          ['/zh-tw/terms/', '使用條款'],
          ['/zh-tw/disclaimer/', '免責聲明'],
          ['/zh-tw/affiliate-disclosure/', '聯盟行銷揭露'],
        ],
      },
    ]
  : [
      {
        heading: 'Collections',
        links: [
          ['/guides/', 'Guides'],
          ['/tools/', 'Tools'],
          ['/checklists/', 'Checklists'],
          ['/templates/', 'Templates'],
          ['/features/', 'Features'],
        ],
      },
      {
        heading: 'Product',
        links: [
          ['/app/', 'Open the app'],
          ['/pricing/', 'Pricing (free)'],
          ['/search/', 'Search'],
          ['/roadmap/', 'Roadmap'],
          ['/changelog/', 'Changelog'],
        ],
      },
      {
        heading: 'Company',
        links: [
          ['/about/', 'About FamilyBoard'],
          ['/contact/', 'Contact'],
          ['/editorial-policy/', 'Editorial policy'],
        ],
      },
      {
        heading: 'Legal',
        links: [
          ['/privacy/', 'Privacy'],
          ['/security/', 'Security'],
          ['/terms/', 'Terms'],
          ['/disclaimer/', 'Disclaimer'],
          ['/affiliate-disclosure/', 'Affiliate disclosure'],
        ],
      },
    ];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand" href={isZhTw ? '/zh-tw/' : '/'}><img class="brand-logo" src="/brand/familyboard-mark.png" width="46" height="46" alt="" />{brand.name}</a>
      <p>{isZhTw ? '把居家保養、保固與家庭責任整理在自己的裝置上。' : brand.primaryTagline}</p>
      <p>{isZhTw ? '免費、local-first，不需註冊帳號。' : 'Free, local-first and useful without an account.'}</p>
      <p class="footer-legal">© {year} {brand.name}</p>
    </div>
    <div class="footer-links">
      {groups.map((group) => (
        <nav class="footer-group" aria-label={group.heading}>
          <h2 class="footer-heading">{group.heading}</h2>
          {group.links.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
      ))}
    </div>
  </div>
</footer>
