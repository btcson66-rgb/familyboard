---
import { brand } from '../config/brand';
interface Props { locale?: 'en' | 'zh-TW'; }
const { locale = 'en' } = Astro.props;
const isZhTw = locale === 'zh-TW';
const englishLinks = [
  ['/features/', 'Features'], ['/guides/', 'Guides'], ['/tools/', 'Tools'], ['/checklists/', 'Checklists'], ['/templates/', 'Templates'],
  ['/privacy/', 'Privacy'], ['/security/', 'Security'], ['/editorial-policy/', 'Editorial policy'], ['/affiliate-disclosure/', 'Affiliate disclosure'],
  ['/roadmap/', 'Roadmap'], ['/changelog/', 'Changelog'], ['/terms/', 'Terms'], ['/disclaimer/', 'Disclaimer'], ['/contact/', 'Contact']
];
const zhTwLinks = [
  ['/zh-tw/', '繁中首頁'], ['/zh-tw/features/free-home-management-app/', 'App 使用教學'], ['/zh-tw/guides/home-maintenance-schedule/', '居家保養指南'],
  ['/zh-tw/tools/home-maintenance-schedule-generator/', '保養排程產生器'], ['/zh-tw/tools/warranty-expiration-calculator/', '保固到期計算器'],
  ['/zh-tw/tools/household-subscription-cost-calculator/', '訂閱費用計算器'], ['/zh-tw/tools/emergency-contact-sheet-generator/', '緊急聯絡表產生器'],
  ['/zh-tw/privacy/', '隱私權政策'], ['/zh-tw/contact/', '聯絡我們'],
  ['/security/', '安全說明（英文）'], ['/affiliate-disclosure/', '聯盟揭露（英文）']
];
const links = isZhTw ? zhTwLinks : englishLinks;
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div><a class="brand" href={isZhTw ? '/zh-tw/' : '/'}><img class="brand-logo" src="/brand/familyboard-mark.png" width="46" height="46" alt="" />{brand.name}</a><p>{isZhTw ? '把居家保養、保固與家庭責任整理在自己的裝置上。' : brand.primaryTagline}</p><p>{isZhTw ? '免費、local-first，不需註冊帳號。' : 'Free, local-first and useful without an account.'}</p></div>
    <nav class="footer-links" aria-label={isZhTw ? '頁尾導覽' : 'Footer navigation'}>{links.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
  </div>
</footer>
