---
import { brand } from '../config/brand';
interface Props { locale?: 'en' | 'zh-TW'; }
const { locale = 'en' } = Astro.props;
const isZhTw = locale === 'zh-TW';
const englishLinks = [
  ['/features/', 'Features'], ['/guides/', 'Guides'], ['/tools/', 'Tools'], ['/checklists/', 'Checklists'], ['/templates/', 'Templates'],
  ['/privacy/', 'Privacy'], ['/security/', 'Security'], ['/editorial-policy/', 'Editorial policy'], ['/affiliate-disclosure/', 'Affiliate disclosure'],
  ['/roadmap/', 'Roadmap'], ['/changelog/', 'Changelog'], ['/terms/', 'Terms'], ['/disclaimer/', 'Disclaimer'], ['/contact/', 'Contact']
];
const zhTwLinks = [
  ['/zh-tw/', '繁中首頁'], ['/zh-tw/features/free-home-management-app/', 'App 使用教學'], ['/zh-tw/guides/home-maintenance-schedule/', '居家保養指南'],
  ['/zh-tw/tools/home-maintenance-schedule-generator/', '保養排程產生器'], ['/zh-tw/tools/warranty-expiration-calculator/', '保固到期計算器'],
  ['/zh-tw/tools/household-subscription-cost-calculator/', '訂閱費用計算器'], ['/zh-tw/tools/emergency-contact-sheet-generator/', '緊急聯絡表產生器'],
  ['/zh-tw/tools/annual-subscription-cost-calculator/', '訂閱年成本計算器'], ['/zh-tw/tools/emergency-binder-generator/', '家庭緊急資料夾'],
  ['/zh-tw/tools/appliance-age-calculator/', '家電年齡計算器'], ['/zh-tw/tools/home-maintenance-cost-tracker/', '維護費用追蹤器'],
  ['/zh-tw/tools/home-repair-cost-log/', '居家修繕費用紀錄'], ['/zh-tw/tools/home-service-reminder-generator/', '到府服務提醒產生器'],
  ['/zh-tw/tools/receipt-retention-organizer/', '收據保存整理器'],
  ['/zh-tw/tools/household-annual-review-generator/', '家庭年度總整理'], ['/zh-tw/tools/move-in-checklist-generator/', '搬入新家清單'],
  ['/zh-tw/tools/move-out-condition-record-generator/', '退租點交紀錄表'],
  ['/zh-tw/tools/vacation-shutdown-checklist-generator/', '旅行前住家清單'],
  ['/zh-tw/tools/house-sitter-instruction-generator/', '看家注意事項'], ['/zh-tw/tools/pet-sitter-instruction-generator/', '寵物照護交接表'],
  ['/zh-tw/tools/home-handoff-summary-generator/', '家庭交接摘要'],
  ['/zh-tw/tools/appliance-replacement-planner/', '家電汰換評估表'], ['/zh-tw/tools/room-inventory-generator/', '房間物品清冊'],
  ['/zh-tw/tools/warranty-checklist-generator/', '保固資料檢查表'],
  ['/zh-tw/tools/cleaning-schedule-generator/', '家庭清潔排程'],
  ['/zh-tw/guides/appliance-replacement-planning/', '家電修換決策教學'], ['/zh-tw/guides/room-by-room-home-inventory/', '家庭財物清冊教學'],
  ['/zh-tw/guides/cleaning-schedule/', '清潔排程教學'],
  ['/zh-tw/guides/move-out-home-records/', '退租點交教學'],
  ['/zh-tw/tools/recurring-chore-planner/', '家事輪值表產生器'],
  ['/zh-tw/tools/home-inventory-checklist-generator/', '住宅財物盤點清單'], ['/zh-tw/tools/household-document-index-generator/', '家庭文件索引產生器'],
  ['/zh-tw/tools/appliance-maintenance-checklist-generator/', '家電保養清單產生器'],
  ['/zh-tw/guides/digital-home-inventory-backup/', '備份還原教學'], ['/zh-tw/guides/home-maintenance-log/', '保養紀錄教學'],
  ['/zh-tw/features/home-inventory-tracker/', '家庭資產 App 教學'], ['/zh-tw/features/family-task-manager/', '家庭任務 App 教學'],
  ['/zh-tw/features/home-dashboard/', '今日總覽教學'], ['/zh-tw/features/maintenance-tracker/', '保養維護 App 教學'],
  ['/zh-tw/features/warranty-tracker/', '保固管理 App 教學'], ['/zh-tw/features/household-subscription-tracker/', '訂閱管理 App 教學'],
  ['/zh-tw/features/household-calendar/', '家庭行事曆 App 教學'], ['/zh-tw/features/emergency-information-organizer/', '緊急聯絡 App 教學'],
  ['/zh-tw/features/family-display-mode/', '舊平板家庭看板教學'], ['/zh-tw/features/household-documents-organizer/', '家庭文件管理 App 教學'],
  ['/zh-tw/features/private-family-organizer/', '隱私家庭管理 App'], ['/zh-tw/features/offline-household-organizer/', '離線家庭管理 App'],
  ['/zh-tw/features/household-handoff/', '家庭交接教學'],
  ['/zh-tw/guides/how-to-track-product-warranties/', '保固追蹤教學'],
  ['/zh-tw/guides/organize-household-subscriptions/', '訂閱管理教學'], ['/zh-tw/guides/household-documents-organizer/', '文件索引教學'],
  ['/zh-tw/privacy/', '隱私權政策'], ['/zh-tw/security/', '資安說明'], ['/zh-tw/affiliate-disclosure/', '聯盟行銷揭露'],
  ['/zh-tw/terms/', '使用條款'], ['/zh-tw/contact/', '聯絡我們']
];
const links = isZhTw ? zhTwLinks : englishLinks;
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div><a class="brand" href={isZhTw ? '/zh-tw/' : '/'}><img class="brand-logo" src="/brand/familyboard-mark.png" width="46" height="46" alt="" />{brand.name}</a><p>{isZhTw ? '把居家保養、保固與家庭責任整理在自己的裝置上。' : brand.primaryTagline}</p><p>{isZhTw ? '免費、local-first，不需註冊帳號。' : 'Free, local-first and useful without an account.'}</p></div>
    <nav class="footer-links" aria-label={isZhTw ? '頁尾導覽' : 'Footer navigation'}>{links.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
  </div>
</footer>
