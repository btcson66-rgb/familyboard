---
import { monetization } from '../config/monetization';
const { route } = Astro.props as { route: string };
const groups = [
  { test: /filter|air-conditioner|furnace|refrigerator|range-hood/, items: [['Replacement filters', 'replacement filters home appliance'], ['Filter labels', 'waterproof label maker household']] },
  { test: /emergency|storm|outage/, items: [['Emergency supply organizer', 'emergency supply organizer bins'], ['Battery and flashlight organizer', 'battery storage organizer flashlight']] },
  { test: /display|tablet/, items: [['Tablet stand', 'tablet stand home dashboard'], ['Wall mount', 'tablet wall mount home']] },
  { test: /document|receipt|warranty|manual/, items: [['Document scanner', 'document scanner home receipts'], ['Fire-resistant document pouch', 'fire resistant document pouch']] },
  { test: /inventory|label|organizer/, items: [['Label maker', 'label maker home organization'], ['Storage labels', 'home storage labels']] }
];
const group = groups.find((candidate) => candidate.test.test(route));
const enabled = monetization.affiliateEnabled && group;
const link = (query: string) => `https://www.amazon.com/s?k=${encodeURIComponent(query)}&tag=${encodeURIComponent(monetization.affiliateTag)}`;
---
{enabled && <aside class="recommendations" aria-labelledby="recommended-heading">
  <div class="affiliate-label">Affiliate recommendation</div>
  <h2 id="recommended-heading">Useful shopping categories for this task</h2>
  <p>These links help you compare relevant products. Verify compatibility, current specifications, price and manufacturer guidance before buying.</p>
  <div class="recommendation-grid">{group.items.map(([label, query]) => <a class="recommendation-link" data-affiliate-category={label} href={link(query)} rel="sponsored nofollow noopener" target="_blank"><strong>{label}</strong><span>Compare current listings →</span></a>)}</div>
  <p class="help">As an affiliate, FamilyBoard may earn from qualifying purchases. <a href="/affiliate-disclosure/">Read the full disclosure.</a></p>
</aside>}
