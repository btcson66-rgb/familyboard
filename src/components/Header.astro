---
import { brand } from '../config/brand';
interface Props {
  locale?: 'en' | 'zh-TW';
  languageSwitchPath?: string;
}
const { locale = 'en', languageSwitchPath = '/zh-tw/' } = Astro.props;
const isZhTw = locale === 'zh-TW';
---
<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href={isZhTw ? '/zh-tw/' : '/'} aria-label={isZhTw ? `${brand.name} 繁體中文首頁` : `${brand.name} home`}><span class="brand-mark" aria-hidden="true">⌂</span>{brand.name}</a>
    <nav class="nav-links" aria-label={isZhTw ? '主要導覽' : 'Primary navigation'}>
      {isZhTw ? <>
        <a href="/zh-tw/guides/home-maintenance-schedule/">居家保養指南</a><a href="/zh-tw/tools/warranty-expiration-calculator/">免費工具</a>
      </> : <>
        <a href="/features/">Product</a><a href="/guides/">Guides</a><a href="/tools/">Tools</a><a href="/checklists/">Printables</a><a href="/pricing/">Free</a><a href="/search/" aria-label="Search">Search</a>
      </>}
      <a class="language-switch" href={languageSwitchPath} hreflang={isZhTw ? 'en' : 'zh-TW'} lang={isZhTw ? 'en' : 'zh-TW'} aria-label={isZhTw ? 'Switch to English' : '切換至繁體中文'}>{isZhTw ? 'English' : '繁體中文'}</a>
      <a class="nav-open" href="/app/">{isZhTw ? '開啟免費 App' : 'Open app'}</a>
    </nav>
  </div>
</header>
