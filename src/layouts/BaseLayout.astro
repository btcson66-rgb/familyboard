---
import '../styles/global.css';
import { brand } from '../config/brand';
import { monetization } from '../config/monetization';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { APP_VERSION } from '../config/app';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  alternatePath?: string;
  locale?: 'en' | 'zh-TW';
  indexable?: boolean;
  robots?: string;
  pageType?: 'website' | 'article' | 'app';
  bodyClass?: string;
  publishedAt?: Date;
  lastReviewedAt?: Date;
  faq?: Array<{ question: string; answer: string }>;
  publicIntegrationsEnabled?: boolean;
  redirectRefresh?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  alternatePath,
  locale = 'en',
  indexable = true,
  robots,
  pageType = 'website',
  bodyClass = '',
  publishedAt,
  lastReviewedAt,
  faq = [],
  publicIntegrationsEnabled = true,
  redirectRefresh
} = Astro.props;
const canonical = new URL(canonicalPath, brand.origin).toString();
const robotsContent = robots ?? (indexable ? 'index,follow,max-image-preview:large' : 'noindex,follow');
const alternate = alternatePath ? new URL(alternatePath, brand.origin).toString() : '';
const isZhTw = locale === 'zh-TW';
const englishUrl = isZhTw ? alternate : canonical;
const zhTwUrl = isZhTw ? canonical : alternate;
const languageSwitchPath = alternatePath || (isZhTw ? '/' : '/zh-tw/');
const isApp = /^\/(?:zh-tw\/)?app\//.test(canonicalPath);
const ga4Id = import.meta.env.PROD && !isApp && publicIntegrationsEnabled ? import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim() : '';
const adsenseAccount = !isApp && publicIntegrationsEnabled && monetization.adsensePublisherId ? `ca-${monetization.adsensePublisherId.replace(/^ca-/, '')}` : '';
// AdSense verification loader. The account meta alone is not what review looks for —
// it looks for the adsbygoogle.js tag in the served HTML of real pages. Gated on
// adsenseAccount so it inherits the exclusions that were already correct: /app/
// surfaces (isApp) and redirect stubs (publicIntegrationsEnabled: false, which
// postbuild-audit asserts must carry no AdSense metadata). The extra noindex check
// keeps it off 404 and any other page Google is told to ignore — a noindex page must
// not request ads. Loads the script only; monetization.adsEnabled still gates every
// visible unit, so no ad renders anywhere while the site is under review.
const adsenseLoader = adsenseAccount && !robotsContent.includes('noindex') ? adsenseAccount : '';
const organizationId = `${brand.origin}/#organization`;
const websiteId = `${brand.origin}/#website`;
const logoUrl = `${brand.origin}/brand/familyboard-mark.png`;
const schema = pageType === 'app'
  ? { '@context': 'https://schema.org', '@type': 'WebApplication', '@id': `${canonical}#app`, name: brand.name, url: canonical, applicationCategory: 'LifestyleApplication', operatingSystem: 'Any', browserRequirements: 'Requires a modern browser with IndexedDB and Web Crypto support', softwareVersion: APP_VERSION, isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description, image: logoUrl, publisher: { '@id': organizationId } }
  : {
      '@context': 'https://schema.org',
      '@type': pageType === 'article' ? 'Article' : 'WebPage',
      '@id': `${canonical}#webpage`,
      name: title,
      headline: pageType === 'article' ? title.replace(/ \|.*$/, '') : undefined,
      url: canonical,
      description,
      inLanguage: locale,
      author: pageType === 'article' ? { '@type': 'Organization', name: isZhTw ? 'FamilyBoard 編輯團隊' : 'FamilyBoard Editorial Team', url: `${brand.origin}/editorial-policy/` } : undefined,
      datePublished: publishedAt?.toISOString(),
      dateModified: lastReviewedAt?.toISOString(),
      isPartOf: { '@id': websiteId },
      publisher: { '@id': organizationId }
    };
const organizationSchema = canonicalPath === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: brand.name,
  url: brand.origin,
  logo: { '@type': 'ImageObject', url: logoUrl, width: 256, height: 256 },
  description: brand.productDescription
} : null;
const websiteSchema = canonicalPath === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: brand.name,
  url: brand.origin,
  publisher: { '@id': organizationId },
  inLanguage: ['en', 'zh-TW']
} : null;
const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
} : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#176b52" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    {redirectRefresh && <meta http-equiv="refresh" content={redirectRefresh} />}
    {adsenseAccount && <meta name="google-adsense-account" content={adsenseAccount} />}
    {adsenseLoader && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseLoader}`} crossorigin="anonymous"></script>}
    <link rel="canonical" href={canonical} />
    {alternate && <>
      <link rel="alternate" hreflang="en" href={englishUrl} />
      <link rel="alternate" hreflang="zh-TW" href={zhTwUrl} />
      <link rel="alternate" hreflang="x-default" href={englishUrl} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isZhTw ? 'zh_TW' : 'en_US'} />
    {alternate && <meta property="og:locale:alternate" content={isZhTw ? 'en_US' : 'zh_TW'} />}
    <meta property="og:image" content={`${brand.origin}/og-default.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {organizationSchema && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
    {websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {ga4Id && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>}
    {ga4Id && <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4Id, { anonymize_ip: true, allow_google_signals: false });
    </script>}
    <slot name="head" />
  </head>
  <body class:list={[bodyClass]}>
    <a class="skip-link" href="#main-content">{isZhTw ? '跳到主要內容' : 'Skip to content'}</a>
    {!isApp && <Header locale={locale} languageSwitchPath={languageSwitchPath} />}
    <main id="main-content" tabindex="-1"><slot /></main>
    {!isApp && <Footer locale={locale} />}
    <div id="pwa-update" class="pwa-update" role="status" hidden>
      <span>{isZhTw ? '有新版 FamilyBoard 可以使用。' : 'A newer FamilyBoard version is ready.'}</span>
      <button id="pwa-update-button" type="button">{isZhTw ? '立即更新' : 'Update now'}</button>
    </div>
    <script is:inline>
      if ('serviceWorker' in navigator) window.addEventListener('load', async () => {
        const registration = await navigator.serviceWorker.register('/sw.js');
        const banner = document.querySelector('#pwa-update');
        const button = document.querySelector('#pwa-update-button');
        let refreshing = false;
        const offerUpdate = () => {
          if (registration.waiting && navigator.serviceWorker.controller) banner.hidden = false;
        };
        offerUpdate();
        registration.addEventListener('updatefound', () => {
          registration.installing?.addEventListener('statechange', offerUpdate);
        });
        button?.addEventListener('click', () => {
          refreshing = true;
          registration.waiting?.postMessage('SKIP_WAITING');
        });
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (refreshing) location.reload();
        });
      });
    </script>
    {publicIntegrationsEnabled && <script>
      import { initPublicAnalytics } from '../lib/public-analytics';
      initPublicAnalytics();
    </script>}
  </body>
</html>
