{
  "name": "familyboard",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run import:content && astro build",
    "build:downloads": "node scripts/build-downloads.mjs",
    "preview": "astro preview",
    "serve:test": "node scripts/serve-dist.mjs",
    "import:content": "node scripts/import-master.mjs docs/launch-content-master.md",
    "postbuild": "node scripts/split-sitemap.mjs && node scripts/postbuild-audit.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run audit:content && npm run audit:similarity && npm run build && npm run audit:prune && npm run audit:indexing && npm run audit:links && npm run audit:monitor",
    "preflight": "npm run check && npm run audit:phase2 && npm run audit:phase3:static && npm run e2e",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:content": "node scripts/content-audit.mjs",
    "audit:similarity": "node scripts/content-similarity-audit.mjs",
    "audit:indexing": "node scripts/indexing-audit.mjs",
    "audit:links": "node scripts/link-policy-audit.mjs",
    "audit:seo": "node scripts/split-sitemap.mjs && node scripts/postbuild-audit.mjs",
    "audit:prune": "node scripts/prune-acceptance.mjs",
    "audit:monitor": "node scripts/verify-monitor-expectations.mjs",
    "audit:phase2:static": "node scripts/phase2-acceptance.mjs",
    "audit:phase2": "npm run audit:phase2:static && node scripts/build-downloads.mjs --check",
    "audit:phase3:static": "node scripts/phase3-acceptance.mjs",
    "evidence:phase3": "node scripts/capture-phase3-evidence.mjs",
    "monitor:live": "node scripts/monitor-live.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "gsc:bootstrap": "node scripts/gsc-bootstrap.mjs",
    "ga4:bootstrap": "node scripts/ga4-bootstrap.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.3",
    "@astrojs/react": "6.0.3",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.3.4",
    "dexie": "4.4.5",
    "marked": "18.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.11"
  }
}
